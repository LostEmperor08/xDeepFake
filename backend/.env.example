# ==============================================================================
# DEEPFAKE X Backend Environment Configuration
# ==============================================================================

# Application Metadata
APP_NAME="DEEPFAKE X Forensic API"
APP_ENV="development"
DEBUG=true

# Server Networking
HOST="0.0.0.0"
PORT=8000

# Security & CORS (JSON-encoded array of allowed origins)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Upload & File Limits
# Maximum upload size in megabytes (default: 50MB)
MAX_UPLOAD_SIZE_MB=50

# Storage directory for temporary forensic file analysis
UPLOAD_DIR="temp/uploads"

# Allowed file extensions for multimodal analysis
ALLOWED_EXTENSIONS=["jpg", "jpeg", "png", "webp", "mp4", "avi", "mov", "mkv", "wav", "mp3", "flac", "pdf"]

# Log Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL="INFO"
