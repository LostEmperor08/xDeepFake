+        page_count = len(reader.pages)
+    except Exception as exc:
+        return _result(ModuleStatus.FAILED, RiskLevel.INCONCLUSIVE,
+                       {"error": f"Could not parse PDF: {exc}", "file_size_bytes": len(raw)})
+
+    c = _Collector()
+    meta = _read_metadata(reader)
+    _check_metadata(meta, c)
+    revisions = _check_revisions(raw, c)
+    pages = _check_pages(reader, c)
+
+    if HAVE_FITZ:
+        try:
+            _check_spans_fitz(Path(file_path), c)
+        except Exception as exc:  # pragma: no cover
+            limitations.append(f"PyMuPDF text-span check failed: {exc}")
+    else:
+        limitations.append("PyMuPDF not installed: text-span font check skipped (pip install pymupdf).")
+
+    # ---- convert to schema --------------------------------------------------
+    stamp = int(time.time() * 1000)
