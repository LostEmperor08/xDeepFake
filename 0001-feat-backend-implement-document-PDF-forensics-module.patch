-"""Document Forensic Analysis Subsystem (Phase 1 Baseline).
+"""Document Forensic Analysis Subsystem (Phase 2).
 
-Planned capabilities for Phase 2:
-- PDF Object Stream & Incremental Update Analysis
-- Font Embedding Inconsistency & Kerning Discontinuities
-- Generative Text / Synthetic Layout Detection
-- Digital Signature & Revision History Integrity
+Rule-based PDF forensics. No ML model is used: every check inspects the file's
+own structure and reports *review indicators* (clues, never proof).
+
+Checks
+------
+1. Metadata      - Creator / Producer / Author / Title, Info dictionary vs XMP.
+2. Timeline      - Created vs Modified dates (later save, impossible order, future dates).
+3. Software      - Producer names of common PDF editing tools.
+4. Raw bytes     - ``%%EOF`` / ``startxref`` / ``/Prev`` counts -> incremental updates.
+5. Signatures    - ``/Sig`` / ``/ByteRange`` lowers severity (signing legitimately adds a revision).
+6. Overlays      - White-filled rectangles painted over content + mixed font families.
+7. Layers        - Annotations on top of the page, extra content streams, form fields.
+8. Text spans    - (PyMuPDF only) font/size changes inside one text line.
+
+Dependencies: ``pypdf`` (required). ``PyMuPDF`` (``fitz``) is optional and enables
+check 8 plus precise overlay detection; the module degrades gracefully without it.
+
+Author: Pratiksha (document authenticity module).
 """
 
+from __future__ import annotations
+
+import re
 import time
+from collections import Counter
+from datetime import datetime, timedelta, timezone
 from pathlib import Path
+from typing import Any, Dict, List, Optional
 
 from app.schemas import (
+    Evidence,
+    Finding,
     Modality,
     ModuleResult,
     ModuleStatus,
     RiskLevel,
 )
 
+try:  # pragma: no cover - import guard
+    from pypdf import PdfReader
+
+    HAVE_PYPDF = True
+except ImportError:  # pragma: no cover
+    HAVE_PYPDF = False
+
+try:  # pragma: no cover - optional dependency
+    import fitz  # PyMuPDF
+
+    HAVE_FITZ = True
+except ImportError:  # pragma: no cover
+    HAVE_FITZ = False
+
+
+MODULE_ID = "document_forensics"
+
+# Producer/creator names of tools that can edit existing PDFs. A hit is a clue only.
+EDITOR_KEYWORDS = [
+    "ilovepdf", "smallpdf", "sejda", "pdfescape", "foxit phantom", "nitro",
+    "pdf-xchange", "pdfelement", "wondershare", "acrobat pro", "photoshop",
+    "inkscape", "pdffiller", "dochub", "canva", "pypdf", "pikepdf", "qpdf",
+]
+
+# Indicator weight -> contributes to the module's review score (0-100).
+SEVERITY_TO_RISK = {
+    "info": RiskLevel.LOW,
+    "low": RiskLevel.LOW,
+    "medium": RiskLevel.MEDIUM,
+    "high": RiskLevel.HIGH,
+}
+
+BASE_LIMITATIONS = [
+    "Indicators are clues, not proof: digital signing, form filling and re-saving leave the same traces.",
+    "A full re-save (not incremental) can erase earlier revision history.",
+    "Metadata fields can be written by hand, so dates and software names may be forged.",
+    "Digital signatures are detected but NOT cryptographically validated.",
+]
+
+
+# ---------------------------------------------------------------------------
+# Helpers
+# ---------------------------------------------------------------------------
+def _parse_pdf_date(value: Any) -> Optional[datetime]:
+    """Parse a PDF date string such as ``D:20261110093000+05'30'``."""
+    if not value:
+        return None
+    if isinstance(value, datetime):
+        return value
+    s = str(value).strip()
+    if s.startswith("D:"):
+        s = s[2:]
+    m = re.match(
+        r"(\d{4})(\d{2})?(\d{2})?(\d{2})?(\d{2})?(\d{2})?([Zz+\-])?(\d{2})?'?(\d{2})?'?", s
+    )
+    if not m:
+        return None
+    y, mo, d, h, mi, se, sign, tzh, tzm = m.groups()
+    try:
+        dt = datetime(int(y), int(mo or 1), int(d or 1), int(h or 0), int(mi or 0), int(se or 0))
+    except ValueError:
+        return None
+    if sign in ("Z", "z"):
+        dt = dt.replace(tzinfo=timezone.utc)
+    elif sign in ("+", "-"):
+        off = timedelta(hours=int(tzh or 0), minutes=int(tzm or 0))
+        dt = dt.replace(tzinfo=timezone(off if sign == "+" else -off))
+    return dt
+
+
+def _aware(dt: Optional[datetime]) -> Optional[datetime]:
+    if dt is None:
+        return None
+    return dt if dt.tzinfo else dt.replace(tzinfo=timezone.utc)
+
+
+def _iso(dt: Optional[datetime]) -> Optional[str]:
+    return dt.isoformat() if dt else None
+
+
+def _humanize(td: timedelta) -> str:
+    secs = int(td.total_seconds())
+    if secs < 3600:
+        return f"{secs // 60} min"
+    if secs < 86400:
+        return f"{secs // 3600} h"
+    return f"{secs // 86400} days"
+
+
+def _first_word(s: str) -> str:
+    return re.split(r"[\s/;,(]+", s.strip().lower())[0] if s else ""
+
+
+def _base_font(name: Any) -> str:
+    """'ABCDEF+Helvetica-Bold' -> 'Helvetica'."""
+    name = str(name).lstrip("/")
+    if "+" in name and len(name.split("+")[0]) == 6:
+        name = name.split("+", 1)[1]
+    return re.split(r"[-,]", name)[0]
+
+
+class _Collector:
+    """Accumulates indicators in a module-neutral form before schema conversion."""
+
+    def __init__(self) -> None:
+        self.items: List[Dict[str, Any]] = []
+
+    def add(
+        self,
+        code: str,
+        title: str,
+        detail: str,
+        severity: str = "info",
+        weight: int = 0,
+        layer: str = "pdf_metadata",
+        category: str = "Document Structure",
+        data: Optional[Dict[str, Any]] = None,
+    ) -> None:
+        self.items.append(
+            {
+                "code": code,
+                "title": title,
+                "detail": detail,
+                "severity": severity,
+                "weight": weight,
+                "layer": layer,
+                "category": category,
+                "data": data or {},
+            }
+        )
+
+
+# ---------------------------------------------------------------------------
+# Check 1-3: metadata, timeline, software
+# ---------------------------------------------------------------------------
+def _read_metadata(reader: "PdfReader") -> Dict[str, Any]:
+    info = reader.metadata or {}
+    meta: Dict[str, Any] = {
+        "title": info.get("/Title"),
+        "author": info.get("/Author"),
+        "creator": info.get("/Creator"),
+        "producer": info.get("/Producer"),
+        "creation_date": _parse_pdf_date(info.get("/CreationDate")),
+        "modification_date": _parse_pdf_date(info.get("/ModDate")),
+        "xmp": {},
+    }
+    try:
+        x = reader.xmp_metadata
+        if x is not None:
+            meta["xmp"] = {
+                "creator_tool": x.xmp_creator_tool,
+                "producer": x.pdf_producer,
+                "create_date": _iso(x.xmp_create_date),
+                "modify_date": _iso(x.xmp_modify_date),
+            }
+    except Exception:
+        pass
+    for k in ("title", "author", "creator", "producer"):
+        if meta[k] is not None:
+            meta[k] = str(meta[k])
+    return meta
+
+
+def _check_metadata(meta: Dict[str, Any], c: _Collector) -> None:
+    if not meta["creator"] and not meta["producer"]:
+        c.add("META_SOFTWARE_MISSING", "No creator/producer recorded",
+              "The file does not say which software made it. Some tools strip metadata on purpose.",
+              "low", 10, category="Metadata Anomaly")
+    if not meta["creation_date"] and not meta["modification_date"]:
+        c.add("META_DATES_MISSING", "No creation/modification dates",
+              "Dates are missing, so no document timeline can be reconstructed.",
+              "low", 10, category="Metadata Anomaly")
+
+    created, modified = _aware(meta["creation_date"]), _aware(meta["modification_date"])
+    if created and modified:
+        gap = modified - created
+        dates = {"created": _iso(created), "modified": _iso(modified)}
+        if gap < timedelta(0):
+            c.add("META_MOD_BEFORE_CREATE", "Modified date is before creation date",
+                  f"Created {_iso(created)}, modified {_iso(modified)}. Impossible in normal use; "
+                  "dates may have been written by hand or a clock was wrong.",
+                  "high", 30, category="Timeline Inconsistency", data=dates)
+        elif gap > timedelta(minutes=5):
+            c.add("META_MODIFIED_LATER", "File was saved again later",
+                  f"Created {_iso(created)}, last modified {_iso(modified)} ({_humanize(gap)} later). "
+                  "Could be an edit, a signature, or a plain re-save.",
+                  "medium", 15, category="Timeline Inconsistency", data=dates)
+        else:
+            c.add("META_DATES_MATCH", "Creation and modification dates match",
+                  f"Both dates are about {_iso(created)}. No later save is recorded in metadata.",
+                  "info", 0, category="Timeline", data=dates)
+
+    now = datetime.now(timezone.utc)
+    for label, dt in (("creation", created), ("modification", modified)):
+        if dt and dt > now + timedelta(days=1):
+            c.add(f"META_FUTURE_{label.upper()}", f"{label.title()} date is in the future",
+                  f"{_iso(dt)} is after today's date; dates were likely set manually.",
+                  "high", 25, category="Timeline Inconsistency")
+
+    creator, producer = meta["creator"] or "", meta["producer"] or ""
+    if creator and producer and _first_word(creator) != _first_word(producer):
+        c.add("META_CREATOR_PRODUCER_DIFFER", "Created in one app, saved by another",
+              f"Creator = '{creator}', Producer = '{producer}'. Normal for 'Save as PDF' workflows, "
+              "but also seen when a PDF is opened in an editor and re-saved.",
+              "low", 5, category="Software Trail")
+
+    hits = [k for k in EDITOR_KEYWORDS if k in f"{creator} {producer}".lower()]
+    if hits:
+        c.add("META_EDITOR_SOFTWARE", "PDF editing software in metadata",
+              f"Found: {', '.join(hits)}. These tools can edit existing PDFs; presence is a clue only.",
+              "medium", 15, category="Software Trail", data={"matches": hits})
+
+    xmp_producer = (meta["xmp"] or {}).get("producer") or ""
+    if xmp_producer and producer and xmp_producer.strip() != producer.strip():
+        c.add("META_XMP_MISMATCH", "Info and XMP metadata disagree",
+              f"Info Producer = '{producer}' but XMP Producer = '{xmp_producer}'. Often happens when a "
+              "second tool updates only one metadata block.",
+              "medium", 10, category="Metadata Anomaly")
+
+
+# ---------------------------------------------------------------------------
+# Check 4-5: raw bytes, revisions, signatures
+# ---------------------------------------------------------------------------
+def _check_revisions(raw: bytes, c: _Collector) -> Dict[str, Any]:
+    eof_count = len(re.findall(rb"%%EOF", raw))
+    startxref_count = len(re.findall(rb"startxref", raw))
+    prev_links = len(re.findall(rb"/Prev\s+\d+", raw))
+    has_sig = bool(re.search(rb"/Type\s*/Sig\b|/ByteRange", raw))
+    linearized = bool(re.search(rb"/Linearized", raw[:2048]))
+    expected = 2 if linearized else 1
+
+    rev = {
+        "eof_markers": eof_count,
+        "startxref_count": startxref_count,
+        "xref_tables": len(re.findall(rb"(?m)^xref\s*$", raw)),
+        "xref_streams": len(re.findall(rb"/Type\s*/XRef", raw)),
+        "prev_links": prev_links,
+        "estimated_revisions": max(1, startxref_count),
+        "linearized": linearized,
+        "has_signature_dictionary": has_sig,
+    }
+
+    if eof_count > expected:
+        extra = eof_count - expected
+        why = (
+            "A digital signature is present and signing ALWAYS appends a revision, so this may be legitimate."
+            if has_sig
+            else "No signature was found, so the revision came from another later save "
+            "(edit, form fill, annotation, or tampering)."
+        )
+        c.add("RAW_INCREMENTAL_UPDATE", f"{extra} later revision(s) appended to the file",
+              f"Found {eof_count} '%%EOF' markers and {prev_links} '/Prev' links. {why}",
+              "medium" if has_sig else "high", 15 if has_sig else 25,
+              layer="pdf_raw_bytes", category="Incremental Update", data=rev)
+    else:
+        c.add("RAW_SINGLE_REVISION", "Single revision",
+              f"{eof_count} '%%EOF' marker(s) found{' (normal for a linearized file)' if linearized else ''}. "
+              "No incremental update detected.",
+              "info", 0, layer="pdf_raw_bytes", category="Revision History", data=rev)
+
+    if has_sig:
+        c.add("RAW_SIGNATURE_PRESENT", "Digital signature structure found",
+              "A /Sig or /ByteRange entry exists. The certificate chain is not validated by this module.",
+              "info", 0, layer="pdf_raw_bytes", category="Digital Signature")
+
+    last = raw.rfind(b"%%EOF")
+    if last >= 0:
+        tail = len(raw[last + 5:].strip())
+        if tail > 32:
+            c.add("RAW_TRAILING_DATA", "Data after the final %%EOF",
+                  f"{tail} bytes follow the last end-of-file marker. Readers ignore it, but it can hide content.",
+                  "medium", 10, layer="pdf_raw_bytes", category="Structural Anomaly")
+    return rev
+
+
+# ---------------------------------------------------------------------------
+# Check 6-7: fonts, overlays, annotations, forms (pypdf)
+# ---------------------------------------------------------------------------
+_WHITE_RECT = re.compile(
+    r"1(?:\.0+)?\s+1(?:\.0+)?\s+1(?:\.0+)?\s+rg\b(.{0,200}?)"
+    r"(-?[\d.]+)\s+(-?[\d.]+)\s+(-?[\d.]+)\s+(-?[\d.]+)\s+re\s+f\b",
+    re.S,
+)
+
+
+def _check_pages(reader: "PdfReader", c: _Collector) -> List[Dict[str, Any]]:
+    pages: List[Dict[str, Any]] = []
+    for i, page in enumerate(reader.pages, start=1):
+        fonts, annots, boxes, n_streams = set(), [], [], 1
+        try:
+            res = page.get("/Resources")
+            res = res.get_object() if res is not None else {}
+            fdict = res.get("/Font")
+            if fdict is not None:
+                for ref in fdict.get_object().values():
+                    fonts.add(str(ref.get_object().get("/BaseFont", "unknown")).lstrip("/"))
+        except Exception:
+            pass
+        try:
+            for a in page.get("/Annots") or []:
+                annots.append(str(a.get_object().get("/Subtype", "?")).lstrip("/"))
+        except Exception:
+            pass
+        try:
+            cs = page.get("/Contents")
+            cs = cs.get_object() if cs is not None else None
+            n_streams = len(cs) if isinstance(cs, list) else 1
+            content = page.get_contents().get_data().decode("latin-1", "ignore")
+            pw, ph = float(page.mediabox.width), float(page.mediabox.height)
+            for m in _WHITE_RECT.finditer(content):
+                x, y, w, h = (float(v) for v in m.groups()[1:])
+                if abs(w) * abs(h) > 50 and abs(w) < pw * 0.9 and abs(h) < ph * 0.9:
+                    boxes.append([round(x), round(y), round(abs(w)), round(abs(h))])
+        except Exception:
+            pass
+
+        families = sorted({_base_font(f) for f in fonts})
+        visible = [a for a in annots if a not in ("Link", "Widget", "Popup")]
+        pages.append({
+            "page": i, "fonts": sorted(fonts), "font_families": families,
+            "annotations": annots, "content_streams": n_streams, "white_filled_boxes": boxes,
+        })
+
+        if len(families) >= 4:
+            c.add("FONT_MANY_FAMILIES", f"Page {i}: many font families",
+                  f"{len(families)} families: {', '.join(families)}. Designed documents usually use 1-3.",
+                  "low", 5, layer="pdf_fonts", category="Font Inconsistency")
+        if visible:
+            c.add("ANNOT_PRESENT", f"Page {i}: annotations on top of page",
+                  f"Types: {', '.join(Counter(visible).elements())}. Annotations can sit over and hide original text.",
+                  "medium", 15, layer="pdf_annotations", category="Overlay / Layering",
+                  data={"page": i, "annotations": visible})
+        if len(families) >= 2 and boxes:
+            c.add("OVERLAY_WHITEOUT_PATTERN", f"Page {i}: white box painted + mixed fonts",
+                  f"{len(boxes)} white-filled rectangle(s) {boxes} and fonts {families}. Matches the "
+                  "'cover old text, type new text' pattern. Could also be legitimate design.",
+                  "high", 20, layer="pdf_content_stream", category="Overlay / Layering",
+                  data={"page": i, "boxes": boxes, "font_families": families})
+        elif boxes:
+            c.add("OVERLAY_WHITE_BOX_RAW", f"Page {i}: white-filled box(es) in drawing commands",
+                  f"Boxes (x, y, w, h): {boxes}. Can be background design or a whiteout over old text.",
+                  "low", 5, layer="pdf_content_stream", category="Overlay / Layering",
+                  data={"page": i, "boxes": boxes})
+        if n_streams > 1:
+            c.add("PAGE_MULTI_STREAM", f"Page {i}: {n_streams} content streams",
+                  "Extra drawing streams are sometimes added by editors to paint over the original.",
+                  "low", 5, layer="pdf_content_stream", category="Overlay / Layering")
+
+    try:
+        if reader.get_fields():
+            c.add("FORM_FIELDS", "Fillable form fields present",
+                  "Form values can be changed without altering the page design.",
+                  "low", 5, layer="pdf_acroform", category="Editable Content")
+    except Exception:
+        pass
+    return pages
+
+
+# ---------------------------------------------------------------------------
+# Check 8: text spans (PyMuPDF, optional)
+# ---------------------------------------------------------------------------
+def _check_spans_fitz(file_path: Path, c: _Collector) -> None:
+    doc = fitz.open(str(file_path))
+    try:
+        reported = 0
+        for pno, page in enumerate(doc, start=1):
+            for block in page.get_text("dict").get("blocks", []):
+                for line in block.get("lines", []):
+                    spans = [s for s in line.get("spans", []) if s["text"].strip()]
+                    if len(spans) < 2:
+                        continue
+                    fams = sorted({_base_font(s["font"]) for s in spans})
+                    sizes = sorted({round(s["size"], 1) for s in spans})
+                    if (len(fams) > 1 or len(sizes) > 1) and reported < 10:
+                        text = "".join(s["text"] for s in spans).strip()[:60]
+                        c.add("FONT_MIXED_IN_LINE", f"Page {pno}: font changes inside one line",
+                              f"'{text}' uses fonts {fams} / sizes {sizes}. Swapped names, dates or "
+                              "amounts often show up like this.",
+                              "medium", 10, layer="pdf_text_spans", category="Font Inconsistency",
+                              data={"page": pno, "text": text, "fonts": fams, "sizes": sizes})
+                        reported += 1
+    finally:
+        doc.close()
+
+
+# ---------------------------------------------------------------------------
+# Public entry point
+# ---------------------------------------------------------------------------
+def _risk_from_score(score: int) -> RiskLevel:
+    if score >= 50:
+        return RiskLevel.HIGH
+    if score >= 20:
+        return RiskLevel.MEDIUM
+    return RiskLevel.LOW
+
 
 def analyze_document(file_path: Path, filename: str) -> ModuleResult:
-    """Performs Phase 1 baseline inspection on document artifacts (PDF)."""
-    start_time = time.perf_counter()
+    """Inspect a PDF for signs of later modification and return a ``ModuleResult``."""
