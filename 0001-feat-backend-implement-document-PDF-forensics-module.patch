+        limitations.insert(0, "pypdf is not installed: run `pip install pypdf`.")
+        return _result(ModuleStatus.SKIPPED, RiskLevel.INCONCLUSIVE, {"error": "pypdf missing"})
+
+    raw = b""
+    try:
