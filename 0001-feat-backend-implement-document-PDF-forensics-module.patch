+"""Tests for the Document (PDF) Forensic Module.
+
+Fixtures are tiny FICTIONAL PDFs written byte-by-byte here, so no binary
+files are committed and no real documents are involved.
+"""
+
+from pathlib import Path
+
+import pytest
+
+from app.modules.document import analyze_document
+from app.schemas import ModuleStatus, RiskLevel
+
+pytest.importorskip("pypdf")
+
+
+# ---------------------------------------------------------------------------
+# Minimal PDF writer (original file + optional incremental update)
+# ---------------------------------------------------------------------------
+def _build_pdf(objects: dict, root: int, info: int) -> bytes:
+    out = bytearray(b"%PDF-1.4\n%\xe2\xe3\xcf\xd3\n")
+    offsets = {}
+    for num in sorted(objects):
+        offsets[num] = len(out)
+        out += f"{num} 0 obj\n".encode() + objects[num] + b"\nendobj\n"
+    xref_pos = len(out)
+    size = max(objects) + 1
+    out += f"xref\n0 {size}\n0000000000 65535 f \n".encode()
+    for n in range(1, size):
+        out += f"{offsets[n]:010d} 00000 n \n".encode()
+    out += f"trailer\n<< /Size {size} /Root {root} 0 R /Info {info} 0 R >>\nstartxref\n{xref_pos}\n%%EOF\n".encode()
+    return bytes(out)
+
+
+def _append_update(base: bytes, objects: dict, root: int, info: int) -> bytes:
+    """Append an incremental update section, exactly like an editor would."""
+    prev = int(base.rsplit(b"startxref", 1)[1].split()[0])
+    out = bytearray(base)
+    offsets = {}
+    for num in sorted(objects):
+        offsets[num] = len(out)
+        out += f"{num} 0 obj\n".encode() + objects[num] + b"\nendobj\n"
+    xref_pos = len(out)
+    out += b"xref\n"
+    for num in sorted(objects):
+        out += f"{num} 1\n{offsets[num]:010d} 00000 n \n".encode()
+    size = max(objects) + 1
+    out += (f"trailer\n<< /Size {size} /Root {root} 0 R /Info {info} 0 R /Prev {prev} >>\n"
+            f"startxref\n{xref_pos}\n%%EOF\n").encode()
+    return bytes(out)
+
+
+def _stream(data: bytes) -> bytes:
+    return f"<< /Length {len(data)} >>\nstream\n".encode() + data + b"\nendstream"
+
+
+ORIGINAL_CONTENT = (b"BT /F1 20 Tf 150 500 Td (Certificate of Participation - DEMO) Tj ET\n"
+                    b"BT /F1 16 Tf 200 400 Td (Score: 62 / 100) Tj ET")
+
+
+def _original_objects() -> dict:
+    return {
+        1: b"<< /Type /Catalog /Pages 2 0 R >>",
+        2: b"<< /Type /Pages /Kids [3 0 R] /Count 1 >>",
+        3: (b"<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] "
+            b"/Resources << /Font << /F1 5 0 R >> >> /Contents 4 0 R >>"),
+        4: _stream(ORIGINAL_CONTENT),
+        5: b"<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>",
+        6: (b"<< /Title (Demo Certificate - SAMPLE) /Author (DeepfakeX Team demo) "
+            b"/Creator (DeepfakeX Sample Generator) /Producer (DeepfakeX Sample Generator) "
+            b"/CreationDate (D:20261001100000+05'30') /ModDate (D:20261001100000+05'30') >>"),
+    }
+
+
+@pytest.fixture
+def original_pdf(tmp_path: Path) -> Path:
+    p = tmp_path / "demo_original.pdf"
+    p.write_bytes(_build_pdf(_original_objects(), root=1, info=6))
+    return p
+
+
+@pytest.fixture
+def edited_pdf(tmp_path: Path) -> Path:
+    base = _build_pdf(_original_objects(), root=1, info=6)
+    overlay = (b"q 1 1 1 rg 195 395 160 25 re f Q\n"
+               b"BT /F2 17 Tf 200 400 Td (Score: 98 / 100) Tj ET")
+    update = {
+        3: (b"<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] "
+            b"/Resources << /Font << /F1 5 0 R /F2 8 0 R >> >> /Contents [4 0 R 7 0 R] /Annots [9 0 R] >>"),
+        6: (b"<< /Title (Demo Certificate - SAMPLE) /Author (DeepfakeX Team demo) "
+            b"/Creator (DeepfakeX Sample Generator) /Producer (iLovePDF demo edit) "
+            b"/CreationDate (D:20261001100000+05'30') /ModDate (D:20261107150000+05'30') >>"),
+        7: _stream(overlay),
+        8: b"<< /Type /Font /Subtype /Type1 /BaseFont /Times-Bold >>",
+        9: b"<< /Type /Annot /Subtype /FreeText /Rect [400 700 560 725] /Contents (Verified copy) /DA (/Helv 11 Tf 0 g) >>",
+    }
+    p = tmp_path / "demo_edited.pdf"
+    p.write_bytes(_append_update(base, update, root=1, info=6))
+    return p
+
+
+def _codes(result):
+    return {e.metadata["indicator"] for e in result.evidence}
+
+
+# ---------------------------------------------------------------------------
+# Tests
+# ---------------------------------------------------------------------------
+def test_original_pdf_has_no_strong_indicators(original_pdf):
+    res = analyze_document(original_pdf, original_pdf.name)
+    assert res.status == ModuleStatus.COMPLETED
+    assert res.module == "document_forensics"
+    assert res.risk_level == RiskLevel.LOW
+    assert res.details["verdict"] == "no_strong_indicators"
+    assert res.details["page_count"] == 1
+    assert res.details["revisions"]["eof_markers"] == 1
+    assert res.details["metadata"]["producer"] == "DeepfakeX Sample Generator"
+    assert "RAW_SINGLE_REVISION" in _codes(res)
+    assert "META_DATES_MATCH" in _codes(res)
+    assert res.findings == []
+    assert res.model_confidence is None
+
+
+def test_edited_pdf_flags_multiple_indicators(edited_pdf):
+    res = analyze_document(edited_pdf, edited_pdf.name)
+    codes = _codes(res)
+    assert res.status == ModuleStatus.COMPLETED
+    assert res.risk_level == RiskLevel.HIGH
+    assert res.details["verdict"] == "multiple_indicators"
+    assert res.details["revisions"]["eof_markers"] == 2
+    assert res.details["revisions"]["prev_links"] == 1
+    for expected in ("RAW_INCREMENTAL_UPDATE", "META_MODIFIED_LATER", "META_EDITOR_SOFTWARE",
+                     "ANNOT_PRESENT", "OVERLAY_WHITEOUT_PATTERN", "PAGE_MULTI_STREAM"):
+        assert expected in codes, expected
+    # every finding must point at real evidence
+    ev_ids = {e.id for e in res.evidence}
+    assert res.findings and all(set(f.evidence_refs) <= ev_ids for f in res.findings)
+
+
+def test_signature_lowers_revision_severity(tmp_path):
+    base = _build_pdf(_original_objects(), root=1, info=6)
+    sig = {10: b"<< /Type /Sig /Filter /Adobe.PPKLite /ByteRange [0 10 20 30] /Contents <00> >>"}
+    p = tmp_path / "demo_signed.pdf"
+    p.write_bytes(_append_update(base, sig, root=1, info=6))
+    res = analyze_document(p, p.name)
+    inc = next(e for e in res.evidence if e.metadata["indicator"] == "RAW_INCREMENTAL_UPDATE")
+    assert inc.metadata["severity"] == "medium"
+    assert "RAW_SIGNATURE_PRESENT" in _codes(res)
+
+
+def test_modified_before_created_is_high(tmp_path):
+    objs = _original_objects()
+    objs[6] = b"<< /Producer (Demo) /CreationDate (D:20261010100000Z) /ModDate (D:20261001100000Z) >>"
+    p = tmp_path / "demo_dates.pdf"
+    p.write_bytes(_build_pdf(objs, root=1, info=6))
+    res = analyze_document(p, p.name)
+    assert "META_MOD_BEFORE_CREATE" in _codes(res)
+
+
+def test_corrupt_pdf_returns_failed_status(tmp_path):
+    p = tmp_path / "broken.pdf"
+    p.write_bytes(b"%PDF-1.4\nthis is not a real pdf body")
+    res = analyze_document(p, p.name)
+    assert res.status == ModuleStatus.FAILED
+    assert res.risk_level == RiskLevel.INCONCLUSIVE
+    assert "error" in res.details
